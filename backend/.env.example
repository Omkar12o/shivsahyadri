# ============================================================================
# Backend environment (server-side ONLY - never expose these to the frontend).
# Copy to Vercel Environment Variables for the backend project.
# ============================================================================

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Web Push / VAPID (private key is server-only; the PUBLIC key goes in frontend as VITE_VAPID_PUBLIC_KEY)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@shivsaydri.in

# Cloudinary (API key/secret server-only)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional shared secret for scheduled /api/birthday-worker calls
CRON_SECRET=change-me