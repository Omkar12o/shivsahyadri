# Copy to .env and fill in real values. NEVER commit the real .env.

# Backend API (deployed separately to Vercel - see backend/ folder).
# Used for server-only operations: sending push notifications and deleting
# Cloudinary assets. If empty, the app falls back to Supabase Edge Functions.
VITE_API_URL=https://your-backend.vercel.app

# Supabase project
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Cloudinary unsigned upload (browser-safe only; never put API secret here)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# Web Push VAPID PUBLIC key (public by design; private key stays server-side)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key