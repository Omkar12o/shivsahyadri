# ============================================================================
# Supabase backend env (for the Supabase CLI and the Edge Function)
# Copy to `.env.local` and fill in values. Never commit real secrets.
# ============================================================================

# For hosting/deploying migrations & functions with the Supabase CLI:
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=

# Set as an Edge Function secret (server-side only) so the scheduled
# birthday-worker can run the service-role SQL function:
#   npx supabase secrets set SUPABASE_SERVICE_ROLE_KEY="<service_role_key>"
SUPABASE_SERVICE_ROLE_KEY=
